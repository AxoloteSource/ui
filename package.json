{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@axolotesource/ui",
    "version": "0.1.0",
    "private": false,
    "license": "UNLICENSED",
    "author": "AxoloteSource",
    "description": "Librería de componentes React reutilizables de AxoloteSource",
    "repository": {
        "type": "git",
        "url": "https://github.com/AxoloteSource/ui.git"
    },
    "homepage": "https://github.com/AxoloteSource/ui",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "development": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./styles.css": "./src/styles/index.css",
        "./package.json": "./package.json",
        "./*": {
            "development": "./src/*",
            "types": ["./dist/*.d.ts", "./dist/*/index.d.ts"],
            "import": "./dist/*.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "vite build && vite build --mode types",
        "build:js": "vite build",
        "build:types": "vite build --mode types",
        "dev": "vite build --watch",
        "types": "tsc --noEmit",
        "lint": "eslint . --fix",
        "format": "prettier --write src/",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "pnpm build"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5.104.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "formik": "^2.4.9",
        "i18next": "^25.8.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-i18next": "^16.5.4",
        "react-router-dom": "^7.13.0",
        "react-select": "^5.10.1"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@floating-ui/react": "^0.27.8",
        "@headlessui/react": "^2.2.0",
        "@mantine/core": "^8.3.13",
        "@popperjs/core": "^2.11.8",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-popover": "^1.1.13",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@tanstack/pacer": "^0.1.0",
        "apexcharts": "^4.5.0",
        "axios": "^1.11.0",
        "browser-image-compression": "^2.0.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "frimousse": "^0.4.0",
        "highlight.js": "^11.11.1",
        "input-otp": "^1.4.2",
        "lucide-react": "^1.3.0",
        "mantine-datatable": "^8.3.7",
        "react-animate-height": "^3.2.3",
        "react-apexcharts": "^1.7.0",
        "react-day-picker": "8.10.1",
        "react-dropzone": "^14.3.8",
        "react-error-boundary": "^6.1.0",
        "react-perfect-scrollbar": "^1.5.8",
        "react-phone-input-2": "^2.15.1",
        "react-popper": "^2.3.0",
        "sileo": "^0.1.5",
        "sweetalert2": "^11.26.17",
        "swiper": "^12.2.0",
        "tailwind-merge": "^3.0.1",
        "yup": "^1.7.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@tailwindcss/vite": "^4.1.11",
        "@tanstack/react-query": "5.104.2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.13.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.0.0",
        "@vitest/coverage-v8": "^4.1.12",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.0",
        "formik": "^2.4.9",
        "globals": "^15.14.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.4.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.13.0",
        "react-select": "^5.10.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^7.3.7",
        "vite-plugin-dts": "^4.5.0",
        "vitest": "^4.1.12"
    }
}
